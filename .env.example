# Copy to .env and adjust. Real environment variables take precedence over .env.

# OpenSearch backend (required for indexing and search).
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_TLS=true
OPENSEARCH_REQUEST_TIMEOUT=30
OPENSEARCH_BULK_BATCH=200
# Vector engine. Defaults to "lucene" on Windows (nmslib's native library is missing there and
# crashes OpenSearch) and "nmslib" elsewhere. Lucene allows at most 1024 dimensions.
# KNN_ENGINE=lucene

# Embeddings for semantic retrieval. Set EMBEDDING_ENABLED=false for keyword-only search.
# Anthropic/Claude keys do NOT work here (no embeddings API).
# Re-index after changing the model or dimensions.
EMBEDDING_ENABLED=true

# Option 1: OpenAI (default). Needs EMBEDDING_API_KEY. On Windows use EMBEDDING_DIMENSIONS=1024 or lower.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REQUIRE_API_KEY=true

# Option 2: local Ollama, no key (run `ollama pull nomic-embed-text` first).
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
# EMBEDDING_REQUIRE_API_KEY=false
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=45
VECTOR_CANDIDATES=40

# Chunking (characters). The splitter breaks on paragraphs, lines and sentences before cutting mid-sentence.
# Re-index after changing these.
CHUNK_SIZE=1500
CHUNK_OVERLAP=250

# Optional LLM answer generation (--generate), built on LangChain chat models.
# Without a key, search falls back to extractive answers.
# Option 1: Claude. The key can also be provided as ANTHROPIC_API_KEY.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# Option 2: OpenAI or any OpenAI-compatible endpoint.
# LLM_PROVIDER=openai-compatible
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# Option 3: local Ollama, no key.
# LLM_PROVIDER=openai-compatible
# LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_REQUIRE_API_KEY=false
# LLM_MODEL=llama3.1

# Optional. Defaults to 0.2, except for Claude, where it is not sent (recent models reject custom values).
# LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_REQUIRE_API_KEY=true

# Sources and upload UI.
# UPLOAD_DIR=C:/Users/you/Desktop/rag_sample_data/docs
MAX_UPLOAD_BYTES=52428800
MAX_FILE_BYTES=26214400
# WEB_USER_AGENT=local-rag-search/1.0
WEB_TIMEOUT=20
WEB_MAX_BYTES=5242880
